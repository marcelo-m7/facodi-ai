<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_facodi_ai_prompt_list" model="ir.ui.view">
        <field name="name">facodi.ai.prompt.list</field>
        <field name="model">facodi.ai.prompt</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="capability"/>
                <field name="version"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_facodi_ai_prompt_form" model="ir.ui.view">
        <field name="name">facodi.ai.prompt.form</field>
        <field name="model">facodi.ai.prompt</field>
        <field name="arch" type="xml">
            <form string="AI Prompt">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="capability"/>
                        </group>
                        <group>
                            <field name="version"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Administrator Instructions">
                        <field name="custom_instructions" placeholder="Optional instructions appended to the feature's technical prompt."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_facodi_ai_prompt" model="ir.actions.act_window">
        <field name="name">Prompts</field>
        <field name="res_model">facodi.ai.prompt</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
