<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_facodi_ai_request_list" model="ir.ui.view">
        <field name="name">facodi.ai.request.list</field>
        <field name="model">facodi.ai.request</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="started_at"/>
                <field name="user_id"/>
                <field name="capability"/>
                <field name="provider_code"/>
                <field name="model_name"/>
                <field name="state"/>
                <field name="duration_ms"/>
                <field name="input_tokens"/>
                <field name="output_tokens"/>
                <field name="error_code" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_facodi_ai_request_form" model="ir.ui.view">
        <field name="name">facodi.ai.request.form</field>
        <field name="model">facodi.ai.request</field>
        <field name="arch" type="xml">
            <form string="AI Request" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="state"/>
                            <field name="user_id"/>
                            <field name="profile_id"/>
                            <field name="connection_id"/>
                        </group>
                        <group>
                            <field name="provider_code"/>
                            <field name="model_name"/>
                            <field name="capability"/>
                        </group>
                    </group>
                    <group string="Timing and Usage">
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="duration_ms"/>
                        </group>
                        <group>
                            <field name="input_unit_count"/>
                            <field name="output_unit_count"/>
                            <field name="input_tokens"/>
                            <field name="output_tokens"/>
                        </group>
                    </group>
                    <group string="Failure" invisible="state != 'failed'">
                        <field name="error_code"/>
                        <field name="error_message"/>
                    </group>
                    <notebook groups="facodi_ai.group_ai_admin">
                        <page string="Input Payload">
                            <field name="input_payload_json" nolabel="1"/>
                        </page>
                        <page string="Output Payload">
                            <field name="output_payload_json" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_facodi_ai_request" model="ir.actions.act_window">
        <field name="name">Requests / Usage</field>
        <field name="res_model">facodi.ai.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_state': 0}</field>
    </record>
</odoo>
