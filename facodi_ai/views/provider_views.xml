<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_facodi_ai_provider_list" model="ir.ui.view">
        <field name="name">facodi.ai.provider.list</field>
        <field name="model">facodi.ai.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="adapter_key"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_facodi_ai_provider_form" model="ir.ui.view">
        <field name="name">facodi.ai.provider.form</field>
        <field name="model">facodi.ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="adapter_key"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_facodi_ai_provider" model="ir.actions.act_window">
        <field name="name">Providers</field>
        <field name="res_model">facodi.ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
